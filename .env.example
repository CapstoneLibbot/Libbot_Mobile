# Backend API Base URL (must include /api, no trailing slash).
# NOTE: Real Android/iOS devices cannot call localhost. Use your machine LAN IP or HTTPS domain:
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.8:5205/api

# SignalR Hub URL
EXPO_PUBLIC_SIGNALR_URL=http://192.168.1.8:5205/robotHub

# Optional Map configuration
EXPO_PUBLIC_MAP_PROVIDER=google
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourDevelopmentKeyHere
