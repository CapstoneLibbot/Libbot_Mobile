# LAN address of the host running this compose stack. Never use localhost for a physical kiosk.
XIAOZHI_LAN_IP=192.168.1.20

# WebSocket is reachable by Android kiosks. Keep HTTP loopback-only during the pilot.
XIAOZHI_WS_PORT=8000
XIAOZHI_HTTP_PORT=8003

# DeepSeek LLM credentials. Do not commit a populated .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# LiBot voice-tool MCP server. Use the LAN URL reachable from the Xiaozhi container.
# This value must exactly match VoiceTools:ApiToken in the Libbot_BE secret configuration.
LIBBOT_BE_MCP_URL=http://192.168.1.21:5000/mcp/voice-tools
LIBBOT_VOICE_TOOLS_TOKEN=
