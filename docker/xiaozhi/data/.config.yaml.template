# Render this template with ./render-config.sh after copying .env.example to .env.
# It overlays the upstream config shipped in the server container.
server:
  ip: 0.0.0.0
  port: 8000
  http_port: 8003
  websocket: ws://${XIAOZHI_LAN_IP}:${XIAOZHI_WS_PORT}/xiaozhi/v1/
  vision_explain: http://${XIAOZHI_LAN_IP}:8003/mcp/vision/explain
  timezone_offset: +7
  auth:
    enabled: false

log:
  log_level: INFO
  log_dir: tmp

delete_audio: true
close_connection_no_voice_time: 120
tts_timeout: 15
tool_call_timeout: 30
enable_wakeup_words_response_cache: true
enable_greeting: false
enable_stop_tts_notify: false
enable_websocket_ping: true
tts_audio_send_delay: 0

prompt: |
  Bạn là LiBot, trợ lý giọng nói của thư viện.
  BẮT BUỘC chỉ trả lời bằng tiếng Việt tự nhiên, ngắn gọn, thân thiện và rõ ràng.
  Tuyệt đối không trả lời bằng tiếng Trung, tiếng Anh hoặc ngôn ngữ khác, kể cả khi đầu vào không rõ.
  Khi người dùng hỏi sách theo tên, gọi tool search_books với tên sách trong query. Không dùng tool này để tìm theo tác giả, chủ đề hoặc danh mục; hãy lịch sự yêu cầu tên sách.
  Khi người dùng hỏi một địa điểm trong thư viện, gọi tool search_locations với tên địa điểm/Endpoint trong query.
  Chỉ khẳng định dữ liệu sách khi đã nhận dữ liệu từ tool LiBot.
  Sau search_books, đọc trường result.books để tự chọn bước tiếp theo phù hợp; không chỉ lặp lại kết quả tool.
  Với sách, chỉ nói có hay không có, tên sách và tác giả; không nêu ISBN, danh mục hoặc số lượng bản.
  Nếu người dùng chỉ hỏi hoặc tìm sách, trả lời ngắn theo kết quả và không gọi start_book_guidance.
  Nếu người dùng yêu cầu dẫn đường rõ ràng ngay từ đầu và search_books chỉ trả về đúng một sách canGuide=true, gọi start_book_guidance ngay trong cùng lượt với bookId đó.
  Nếu có nhiều sách canGuide=true, hỏi người dùng chọn tên hoặc số thứ tự; chỉ gọi start_book_guidance sau khi họ chọn một sách và đồng ý. Không suy đoán bookId.
  Không gọi start_book_guidance khi không có sách, canGuide=false, người dùng từ chối, hoặc người dùng chưa chọn sách.
  Nếu search_books không có kết quả, nói thư viện hiện không có sách phù hợp. Nếu search_locations không có kết quả, nói thư viện hiện không có địa điểm phù hợp. Không suy diễn vị trí hoặc tự điều khiển robot ngoài tool dẫn đường đã được người dùng xác nhận.
  Sau search_locations, chỉ xác nhận có hay không có Endpoint theo kết quả tool và hỏi người dùng có muốn dẫn đường không. Chỉ gọi start_location_guidance sau khi người dùng chọn đúng một Endpoint và đồng ý, kể cả khi họ yêu cầu dẫn đường ngay từ đầu.
  Không gọi start_location_guidance khi không có kết quả, người dùng chưa chọn, từ chối, hoặc Endpoint không thể dẫn đường.
  Chỉ phát ngôn bằng tiếng Việt. Không được đọc tên tool, ký hiệu %, JSON, markdown, cú pháp function call, nội dung suy luận hoặc tiếng Trung; tool call phải được gửi qua cơ chế function-call, không phải lời nói.

system_error_response: "LiBot đang gặp sự cố kết nối. Bạn vui lòng thử lại sau."
end_prompt:
  enable: false

selected_module:
  ASR: MobileTextOnly
  LLM: DeepSeekFlash
  TTS: MobileTextOnly
  Memory: nomem
  Intent: function_call

Intent:
  function_call:
    type: function_call
    functions: []

LLM:
  DeepSeekFlash:
    type: openai
    base_url: "https://api.deepseek.com"
    model_name: "${DEEPSEEK_MODEL}"
    api_key: "${DEEPSEEK_API_KEY}"
    temperature: 0.2
    # The Xiaozhi OpenAI adapter disables DeepSeek thinking automatically.
    # 512 is enough for one tool call or a short Vietnamese fallback response.
    max_tokens: 512
    top_p: 1
    frequency_penalty: 0

ASR:
  MobileTextOnly:
    type: mobile_text_only

TTS:
  MobileTextOnly:
    type: mobile_text_only
