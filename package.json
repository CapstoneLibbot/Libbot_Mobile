{
  "name": "libot-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@microsoft/signalr": "^10.0.11",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "^57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "^57.0.11",
    "expo-router": "^57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vosk": "^2.2.0",
    "xiaozhi-audio": "file:./modules/xiaozhi-audio",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "setup:vosk": "bash scripts/setup_vosk_model.sh",
    "postinstall": "patch-package",
    "validate": "npm run typecheck && npm run lint && npm test && npx expo install --check && npx expo-doctor",
    "build:apk:local": "set -a && . ./.env && set +a && export NODE_ENV=production && export ANDROID_HOME=$HOME/Library/Android/sdk && export JAVA_HOME=$(/usr/libexec/java_home) && export PATH=$PATH:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator && (cd android && ./gradlew --no-daemon :app:assembleRelease) && cp android/app/build/outputs/apk/release/app-release.apk build-$(date +%s).apk",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true
}
