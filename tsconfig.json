{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/core": ["./src/core"],
      "@/core/*": ["./src/core/*"],
      "@/features": ["./src/features"],
      "@/features/*": ["./src/features/*"],
      "@/platform": ["./src/platform"],
      "@/platform/*": ["./src/platform/*"],
      "@/shared": ["./src/shared"],
      "@/shared/*": ["./src/shared/*"],
      "@/testing": ["./src/testing"],
      "@/testing/*": ["./src/testing/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
